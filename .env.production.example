# Copiez ce fichier en .env sur le serveur de production puis remplacez toutes
# les valeurs de démonstration. Ne versionnez jamais le fichier .env.
#
# IMPORTANT : si un secret contient le caractère $, entourez toute la valeur
# de guillemets simples. Exemple :
# POSTGRES_ADMIN_PASSWORD='MotDePasse$Secret2026!'
# Vous pouvez aussi remplacer chaque $ par $$.

COMPOSE_PROJECT_NAME=hopital-gestion

# Ressources : profil volontairement prudent pour un VPS de 4 Go de RAM.
# Les plafonds empêchent une JVM ou PostgreSQL de saturer l'hôte.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
SPRING_SERVICE_MEMORY_LIMIT=512m
SPRING_SERVICE_MEMORY_RESERVATION=256m
SPRING_SERVICE_PIDS_LIMIT=160
SPRING_JAVA_TOOL_OPTIONS='-Xms96m -Xmx256m -XX:MaxMetaspaceSize=160m -XX:MaxDirectMemorySize=64m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError'
POSTGRES_MEMORY_LIMIT=768m
POSTGRES_MEMORY_RESERVATION=256m
POSTGRES_PIDS_LIMIT=160
KEYCLOAK_MEMORY_LIMIT=1g
KEYCLOAK_MEMORY_RESERVATION=512m
KEYCLOAK_PIDS_LIMIT=180
KEYCLOAK_JAVA_OPTS_KC_HEAP='-XX:InitialRAMPercentage=20 -XX:MaxRAMPercentage=55 -XX:MaxHeapFreeRatio=50'
KAFKA_MEMORY_LIMIT=768m
KAFKA_MEMORY_RESERVATION=256m
KAFKA_PIDS_LIMIT=160
KAFKA_HEAP_OPTS='-Xms256m -Xmx384m'
ZOOKEEPER_MEMORY_LIMIT=384m
ZOOKEEPER_MEMORY_RESERVATION=128m
ZOOKEEPER_PIDS_LIMIT=120
ZOOKEEPER_HEAP_OPTS='-Xms128m -Xmx192m'
KONG_MEMORY_LIMIT=384m
KONG_MEMORY_RESERVATION=128m
KONG_PIDS_LIMIT=120
REDIS_MEMORY_LIMIT=192m
REDIS_MEMORY_RESERVATION=64m
REDIS_PIDS_LIMIT=80
PROMETHEUS_MEMORY_LIMIT=384m
PROMETHEUS_MEMORY_RESERVATION=128m
PROMETHEUS_PIDS_LIMIT=100
GRAFANA_MEMORY_LIMIT=256m
GRAFANA_MEMORY_RESERVATION=96m
GRAFANA_PIDS_LIMIT=100

# Point d'entrée API réservé au Nginx installé sur le serveur.
HOSPITAL_API_GATEWAY_PORT=8888

# Grafana et Prometheus restent privés par défaut. Passez l'adresse concernée
# à 0.0.0.0 uniquement si le pare-feu du VPS protège le port publié.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_HOST_PORT=3000
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_HOST_PORT=9090

# Premier administrateur de la plateforme. Définissez ces valeurs avant le
# tout premier démarrage : elles ne réinitialisent pas un compte déjà créé.
HOSPITAL_ADMIN_USERNAME=admin
HOSPITAL_ADMIN_EMAIL=admin@niwytech.cloud
HOSPITAL_ADMIN_PASSWORD='ChangezMoi_2026_AdminPlateforme!'

# Port réservé à l'administration locale et aux tunnels SSH DBeaver.
# Il reste lié à 127.0.0.1 et n'est donc pas exposé sur Internet.
POSTGRES_HOST_PORT=54320
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD='ChangezMoi_2026_PostgresAdmin!'
HOSPITAL_DB_USER=hospital
HOSPITAL_DB_PASSWORD='ChangezMoi_2026_HospitalDb!'

KONG_PG_DATABASE=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD='ChangezMoi_2026_Kong!'

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD='ChangezMoi_2026_Keycloak!'
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD='ChangezMoi_2026_Admin!'
# Ce secret est synchronisé au client Keycloak hospital-services par
# keycloak-init ; conservez la même valeur pour auth-service.
KEYCLOAK_CLIENT_SECRET='ChangezMoi_2026_Client!'

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD='ChangezMoi_2026_Grafana!'
