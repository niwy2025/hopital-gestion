            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"HGR-KIN-001\",\n  \"name\": \"Hôpital général de référence de Kinsenso\",\n  \"type\": \"GENERAL_REFERENCE\",\n  \"healthZoneCode\": \"KINSENSO\",\n  \"address\": \"Avenue de la Santé\",\n  \"phoneNumber\": \"+243810000000\"\n}",
