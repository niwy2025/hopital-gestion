# Point d'entrée unique de la plateforme en production.
# Caddy gère le certificat TLS et transmet les API à Kong ; le reste est servi
# par le portail Next.js.
{$HOSPITAL_DOMAIN} {
	encode zstd gzip

	@api path /api/* /gateway/*
	handle @api {
		reverse_proxy kong:8000
	}

	handle {
		reverse_proxy hopital-front:3140
	}
}
