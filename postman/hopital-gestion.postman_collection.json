            "url": {
              "raw": "{{baseUrl}}/api/v1/patients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "patients"]
            }
          }
        },
        {
          "name": "Create patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Amina\",\n  \"lastName\": \"Kasongo\",\n  \"dateOfBirth\": \"1992-05-04\",\n  \"gender\": \"FEMALE\",\n  \"registrationHospitalId\": \"{{hospital_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/patients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "patients"]
            }
          }
        }
      ]
    },
    {
      "name": "06 - Personnel",
      "item": [
        {
          "name": "Search personnel",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/personnel/search?page=0&size=20&active=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "personnel", "search"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "active", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Create personnel member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeNumber\": \"MED-001\",\n  \"firstName\": \"Amina\",\n  \"lastName\": \"Kasongo\",\n  \"gender\": \"FEMALE\",\n  \"category\": \"DOCTOR\",\n  \"jobTitle\": \"Médecin chef\",\n  \"hospitalId\": null,\n  \"accountId\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/personnel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "personnel"]
            }
          }
        }
      ]
    },
    {
      "name": "07 - Laboratoire",
      "item": [
        {
          "name": "List analysis requests",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/laboratory/analysis-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "laboratory", "analysis-requests"]
            }
          }
        },
        {
          "name": "Create analysis request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"REQ-001\",\n  \"laboratoryType\": \"HOSPITAL\",\n  \"laboratoryCode\": \"LAB-HGR-001\",\n  \"patientReference\": \"PAT-001\",\n  \"patientName\": \"Patient de démonstration\",\n  \"analysisCode\": \"NFS\",\n  \"analysisName\": \"Numération formule sanguine\",\n  \"requesterName\": \"Dr. Mbala\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/laboratory/analysis-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "laboratory", "analysis-requests"]
            }
          }
        },
        {
          "name": "Receive specimen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SPEC-001\",\n  \"analysisRequestCode\": \"REQ-001\",\n  \"specimenType\": \"BLOOD\",\n  \"collectedAt\": \"2026-08-25T08:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/laboratory/specimens",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "laboratory", "specimens"]
            }
          }
        },
        {
          "name": "List specimens",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/laboratory/specimens",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "laboratory", "specimens"]
            }
          }
        },
        {
          "name": "List analysis results",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/laboratory/analysis-results",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "laboratory", "analysis-results"]
            }
          }
        },
        {
          "name": "Enter analysis result",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"RES-001\",\n  \"analysisRequestCode\": \"REQ-001\",\n  \"resultValue\": \"12.4\",\n  \"unit\": \"g/dL\",\n  \"referenceRange\": \"12 - 16\",\n  \"comment\": \"Résultat contrôlé avant validation.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/laboratory/analysis-results",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "laboratory", "analysis-results"]
            }
          }
        },
        {
          "name": "Validate analysis result",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"validatedBy\": \"biologiste\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/laboratory/analysis-results/RES-001/validation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "laboratory", "analysis-results", "RES-001", "validation"]
            }
          }
        }
      ]
