# Si une valeur secrète contient le caractère $, utilisez des guillemets
# simples autour de toute la valeur : MOT_DE_PASSE='valeur$secrete'. Sans cela,
# Docker Compose interprète la partie après $ comme une variable d'environnement.

COMPOSE_PROJECT_NAME=hopital-gestion

# Limites de ressources Docker. Elles évitent qu'un seul conteneur monopolise
# l'ordinateur. Adaptez-les seulement si la charge réelle le justifie.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
SPRING_SERVICE_MEMORY_LIMIT=512m
SPRING_SERVICE_MEMORY_RESERVATION=256m
SPRING_SERVICE_PIDS_LIMIT=160
SPRING_JAVA_TOOL_OPTIONS='-Xms96m -Xmx256m -XX:MaxMetaspaceSize=160m -XX:MaxDirectMemorySize=64m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError'
SQLSERVER_CONTAINER_MEMORY_LIMIT=2560m
SQLSERVER_CONTAINER_MEMORY_RESERVATION=1536m
SQLSERVER_PIDS_LIMIT=384
# Cette valeur doit rester sous SQLSERVER_CONTAINER_MEMORY_LIMIT.
MSSQL_MEMORY_LIMIT_MB=2048
KEYCLOAK_MEMORY_LIMIT=1g
KEYCLOAK_MEMORY_RESERVATION=512m
KEYCLOAK_PIDS_LIMIT=180
KEYCLOAK_JAVA_OPTS_KC_HEAP='-XX:InitialRAMPercentage=20 -XX:MaxRAMPercentage=55 -XX:MaxHeapFreeRatio=30'
KAFKA_MEMORY_LIMIT=768m
KAFKA_MEMORY_RESERVATION=256m
KAFKA_PIDS_LIMIT=160
KAFKA_HEAP_OPTS='-Xms256m -Xmx384m'
ZOOKEEPER_MEMORY_LIMIT=384m
ZOOKEEPER_MEMORY_RESERVATION=128m
ZOOKEEPER_PIDS_LIMIT=120
ZOOKEEPER_HEAP_OPTS='-Xms128m -Xmx192m'
POSTGRES_MEMORY_LIMIT=384m
POSTGRES_MEMORY_RESERVATION=128m
POSTGRES_PIDS_LIMIT=100
KONG_MEMORY_LIMIT=384m
KONG_MEMORY_RESERVATION=128m
KONG_PIDS_LIMIT=120
REDIS_MEMORY_LIMIT=192m
REDIS_MEMORY_RESERVATION=64m
REDIS_PIDS_LIMIT=80
PROMETHEUS_MEMORY_LIMIT=384m
PROMETHEUS_MEMORY_RESERVATION=128m
PROMETHEUS_PIDS_LIMIT=100
GRAFANA_MEMORY_LIMIT=256m
GRAFANA_MEMORY_RESERVATION=96m
GRAFANA_PIDS_LIMIT=100

# Point d'entrée HTTP local (Nginx l'utilise sur le serveur de production).
HOSPITAL_API_GATEWAY_PORT=8888

# Premier compte de l'application, créé uniquement si aucun compte équivalent
# n'existe encore. Ces valeurs sont destinées au développement local.
HOSPITAL_ADMIN_USERNAME=admin
HOSPITAL_ADMIN_EMAIL=admin@hopital.local
HOSPITAL_ADMIN_PASSWORD=admin123

# SQL Server
MSSQL_SA_PASSWORD=Your_strong_Password123!
MSSQL_PID=Developer

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_password
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# Kong
KONG_PG_DATABASE=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong_password

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
