{
  "info": {
    "name": "Hopital Gestion - API publique",
    "description": "Collection globale des endpoints publics. Toutes les requêtes passent par l'API Gateway via {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Gateway",
      "item": [
        {
          "name": "Gateway readiness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/gateway/ready",
              "host": ["{{baseUrl}}"],
              "path": ["gateway", "ready"]
            }
          }
        },
        {
          "name": "My account and known devices",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "User-Agent",
                "value": "Hopital-Gestion-Postman/1.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Auth health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "health"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "User-Agent",
                "value": "Hopital-Gestion-Postman/1.0"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const session = pm.response.json();",
                  "pm.environment.set('accessToken', session.accessToken);",
                  "pm.environment.set('refreshToken', session.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "User-Agent",
                "value": "Hopital-Gestion-Postman/1.0"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const session = pm.response.json();",
                  "pm.environment.set('accessToken', session.accessToken);",
                  "pm.environment.set('refreshToken', session.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Accounts",
      "item": [
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            }
          }
        },
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{account_identifier}}\",\n  \"email\": \"patient01@hopital.local\",\n  \"displayName\": \"Patient 01\",\n  \"password\": \"{{account_password}}\",\n  \"roles\": [\"PATIENT\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Notifications",
      "item": [
        {
          "name": "Queue email and SMS broadcast",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"APPOINTMENT_REMINDER\",\n  \"channels\": [\"EMAIL\", \"SMS\"],\n  \"recipients\": [\n    {\n      \"email\": \"patient01@hopital.local\",\n      \"phoneNumber\": \"+243810000000\",\n      \"displayName\": \"Patient 01\"\n    }\n  ],\n  \"subject\": \"Rappel de rendez-vous\",\n  \"body\": \"Votre rendez-vous est prévu demain.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/broadcasts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "broadcasts"]
            }
          }
        }
      ]
    },
    {
