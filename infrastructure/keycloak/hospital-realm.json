{
  "realm": "hospital",
  "enabled": true,
  "displayName": "Hospital Management",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "clients": [
    {
      "clientId": "hospital-web",
      "name": "Hospital Web Client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:4200/*", "http://localhost:3000/*", "http://localhost:3001/*"],
      "webOrigins": ["http://localhost:4200", "http://localhost:3000", "http://localhost:3001"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "hospital-services",
      "name": "Hospital Backend Services",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me-in-production",
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Hospital platform administrator" },
      { "name": "DOCTOR", "description": "Medical practitioner" },
      { "name": "NURSE", "description": "Nursing staff" },
      { "name": "PHARMACIST", "description": "Pharmacist" },
      { "name": "PHARMACY_MANAGER", "description": "Hospital pharmacy inventory manager" },
      { "name": "RECEPTIONIST", "description": "Admissions and front desk" },
      { "name": "HR_MANAGER", "description": "Personnel management" },
      { "name": "PATIENT", "description": "Patient portal user" }
    ]
  }
}
