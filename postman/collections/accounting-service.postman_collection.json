            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/accounting/notes/search?page=0&size=20&query=", "host": ["{{baseUrl}}"], "path": ["api", "v1", "accounting", "notes", "search"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }, { "key": "query", "value": "" }] }
          }
