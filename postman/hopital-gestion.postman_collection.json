{
  "info": {
    "name": "Hopital Gestion",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"admin@hopital.local\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{kong_url}}/api/v1/auth/login",
          "host": [
            "{{kong_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Gateway Readiness",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{gateway_url}}/gateway/ready",
          "host": [
            "{{gateway_url}}"
          ],
          "path": [
            "gateway",
            "ready"
          ]
        }
      }
    },
    {
      "name": "List Roles",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{kong_url}}/api/v1/accounts/roles",
          "host": [
            "{{kong_url}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "roles"
          ]
        }
      }
    },
    {
      "name": "Find Account By Username",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{kong_url}}/api/v1/accounts/identifier/admin",
          "host": [
            "{{kong_url}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "identifier",
            "admin"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "kong_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "gateway_url",
      "value": "http://localhost:8088"
    }
  ]
}
