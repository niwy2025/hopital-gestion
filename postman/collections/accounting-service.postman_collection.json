          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/accounting/journals/search?page=0&size=20&query=", "host": ["{{baseUrl}}"], "path": ["api", "v1", "accounting", "journals", "search"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }, { "key": "query", "value": "" }] }
          }
        },
        {
          "name": "Consulter le grand livre",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/accounting/ledger/search?page=0&size=20&query=", "host": ["{{baseUrl}}"], "path": ["api", "v1", "accounting", "ledger", "search"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }, { "key": "query", "value": "" }] }
          }
        }
      ]
    },
